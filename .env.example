# API-Sports key (free tier: 100 requests/day per sport)
# Sent via x-apisports-key header for API-Football (v3) and API-Rugby (v1)
API_SPORTS_KEY=your_api_sports_key_here

# RapidAPI Darts (Sportbex Darts API)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_DARTS_HOST=darts-api.p.rapidapi.com

# GAA Official eCal Widget & .ics feed URLs
GAA_ECAL_WIDGET_URL=
GAA_ICS_URLS=

# Optional custom User-Agent for Jolpica F1 / public APIs
USER_AGENT=NellyMcsMarbellaSportsFetcher/1.0 (+https://nellymcs.com)
